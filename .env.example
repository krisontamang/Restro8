# Supabase Configuration Template (Public / Anon Only)
# WARNING: NEVER put service_role secret key or DB password in VITE_* environment variables!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Public guest menu base URL used by printed table QR codes
VITE_PUBLIC_MENU_URL=https://your-domain.example/menu

# Direct PostgreSQL Connection (Optional for CLI migrations - NEVER expose in client bundles)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
